---
import MundayGreenWeddingLayout from "@/layouts/MundayGreenWeddingLayout.astro";
import { weddingLabel } from "@/data/munday-green-wedding";
---

<MundayGreenWeddingLayout title={weddingLabel}>
	<div class="mgw-invite-wrap">
		<img
			src="/images/wedding/save-the-date.png"
			alt="Save the Date — Melissa & Samuel, Saturday 17 October 2026 at 3:00 PM, Fernbank Farm, 756 Yarramalong Rd, Wyong Creek NSW 2259"
			class="mgw-invite-img"
		/>
	</div>

	<div class="mgw-section">
		<h2 class="mgw-h2">RSVP</h2>
		<p class="mgw-muted">Please let us know if you can join us by <strong>1 September 2026</strong>.</p>

		<form
			id="rsvp-form"
			class="mgw-rsvp-form"
			action="https://formspree.io/f/maqvanqv"
			method="POST"
		>
			<input type="hidden" name="_subject" value="Wedding RSVP — Melissa & Samuel" />

			<div class="mgw-field">
				<label class="mgw-label" for="rsvp-name">Your name</label>
				<input
					class="mgw-input"
					type="text"
					id="rsvp-name"
					name="name"
					placeholder="Full name"
					required
				/>
			</div>

			<div class="mgw-field">
				<span class="mgw-label">Will you be attending?</span>
				<div class="mgw-radio-group">
					<label class="mgw-radio-label">
						<input type="radio" name="attending" value="Yes, I'll be there!" required />
						Yes, I'll be there! 🎉
					</label>
					<label class="mgw-radio-label">
						<input type="radio" name="attending" value="No, I can't make it" />
						Sorry, I can't make it
					</label>
				</div>
			</div>

			<div class="mgw-field">
				<label class="mgw-label" for="rsvp-note">
					A note for the couple <span class="mgw-optional">(optional)</span>
				</label>
				<textarea
					class="mgw-textarea"
					id="rsvp-note"
					name="note"
					rows="4"
					placeholder="Any message, dietary requirements, or song requests..."
				></textarea>
			</div>

			<button class="mgw-button mgw-button--primary mgw-rsvp-submit" type="submit">
				Send RSVP
			</button>
		</form>

		<div id="rsvp-success" class="mgw-rsvp-success" hidden>
			<p class="mgw-rsvp-thanks">Thank you! We've received your RSVP 🌸</p>
			<p class="mgw-muted">We can't wait to celebrate with you.</p>
		</div>
	</div>
</MundayGreenWeddingLayout>

<style>
	.mgw-invite-wrap {
		display: flex;
		justify-content: center;
		padding: 0.5rem 0;
	}

	.mgw-invite-img {
		width: 100%;
		max-width: 480px;
		height: auto;
		border-radius: 18px;
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12), 0 4px 14px rgba(0, 0, 0, 0.07);
	}
</style>

<script>
	const form = document.getElementById("rsvp-form") as HTMLFormElement | null;
	const successPanel = document.getElementById("rsvp-success") as HTMLElement | null;
	const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!form || !submitBtn) return;

		submitBtn.disabled = true;
		submitBtn.textContent = "Sending…";

		try {
			const response = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});

			if (response.ok) {
				form.hidden = true;
				if (successPanel) successPanel.hidden = false;
			} else {
				submitBtn.disabled = false;
				submitBtn.textContent = "Send RSVP";
				alert("Something went wrong — please try again or email us directly.");
			}
		} catch {
			submitBtn.disabled = false;
			submitBtn.textContent = "Send RSVP";
			alert("Something went wrong — please try again or email us directly.");
		}
	});
</script>
