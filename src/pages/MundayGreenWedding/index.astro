---
import MundayGreenWeddingLayout from "@/layouts/MundayGreenWeddingLayout.astro";
import { coupleName, venue, weddingLabel } from "@/data/munday-green-wedding";
---

<MundayGreenWeddingLayout title={weddingLabel}>
	<p class="mgw-eyebrow">Wedding</p>
	<h1 class="mgw-title">{coupleName}</h1>
	<p class="mgw-subtitle">
		Welcome! Use the contents box on the left to jump between pages.
	</p>

	<div class="mgw-grid">
		<a class="mgw-card mgw-card--link" href="/MundayGreenWedding/schedule/">
			<h2>Schedule</h2>
			<p>Order of events for the day.</p>
		</a>

		<a class="mgw-card mgw-card--link" href="/MundayGreenWedding/venue/">
			<h2>Venue</h2>
			<p>{venue.name} — map + links.</p>
		</a>

		<a class="mgw-card mgw-card--link" href="/MundayGreenWedding/directions/">
			<h2>Directions</h2>
			<p>How to get there, parking, rideshare.</p>
		</a>

		<a class="mgw-card mgw-card--link" href="/MundayGreenWedding/accommodation/">
			<h2>Accommodation</h2>
			<p>Nearby places to stay and travel notes.</p>
		</a>

		<a class="mgw-card mgw-card--link" href="/MundayGreenWedding/registry/">
			<h2>Registry</h2>
			<p>Details coming soon.</p>
		</a>

		<a class="mgw-card mgw-card--link" href="/MundayGreenWedding/faq/">
			<h2>FAQ</h2>
			<p>Dress code, plus-ones, kids, dietary needs.</p>
		</a>
	</div>
</MundayGreenWeddingLayout>
