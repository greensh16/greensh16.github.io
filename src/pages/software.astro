---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Software projects built by Green — hardware integrations, generative models, data tools, and more.",
	title: "Software",
};

const projects = [
	{
		name: "Feilian-3D",
		description:
			"A 3-D generative model framework built for reproducible training runs on HPC clusters. Includes a custom data pipeline, configurable loss functions, Slurm integration, and full API documentation.",
		url: "/docs/",
		tags: ["Python", "Deep Learning", "Slurm", "HPC"],
		internal: true,
	},
	{
		name: "ClimTime",
		description:
			"A MicroPython weather visualiser for an LED matrix. Maps temperature to colour, wind speed to waveform height, and precipitation to animated effects — all driven by live sensor data.",
		url: "/posts/climtime/",
		tags: ["MicroPython", "LED Matrix", "IoT"],
		internal: true,
	},
	{
		name: "Galactic Moon",
		description:
			"A moon-position tracker that computes azimuth and altitude entirely on-device — no external API. Displays the moon's current sky position on an LED matrix using local astronomical math.",
		url: "/posts/galactic-moon/",
		tags: ["MicroPython", "Astronomy", "LED Matrix"],
		internal: true,
	},
	{
		name: "Dask Cluster Setup",
		description:
			"A reproducible configuration and setup guide for running distributed Dask workloads, including worker scaling, scheduler configuration, and environment bootstrapping.",
		url: "/docs/dask-setup",
		tags: ["Python", "Dask", "Distributed Computing"],
		internal: true,
	},
];
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">Software</h1>
	<p class="prose max-w-none text-textColor mb-8">
		A collection of projects I've built or maintain. Source code for most of these lives on
		<a
			aria-label="GitHub profile"
			class="citrus-link"
			href="https://github.com/greensh16"
			rel="noreferrer"
			target="_blank"
		>GitHub</a>.
	</p>

	<ul class="flex flex-col gap-y-6 not-prose">
		{
			projects.map((project) => (
				<li class="rounded-xl border border-special-light bg-special-light/30 p-5 transition-colors hover:border-accent-base/30">
					<div class="flex items-start justify-between gap-x-4">
						<a
							href={project.url}
							class="text-lg font-semibold text-accent-base hover:underline underline-offset-2"
							{...(project.internal ? { "data-astro-prefetch": true } : { rel: "noreferrer", target: "_blank" })}
						>
							{project.name}
						</a>
					</div>
					<p class="mt-2 text-sm text-textColor">{project.description}</p>
					<div class="mt-3 flex flex-wrap gap-2">
						{project.tags.map((tag) => (
							<span class="rounded-md bg-accent-base/10 px-2 py-0.5 text-xs font-medium text-accent-base">
								{tag}
							</span>
						))}
					</div>
				</li>
			))
		}
	</ul>
</PageLayout>
