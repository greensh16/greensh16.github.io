---
import PageLayout from "@/layouts/Base.astro";

interface Props {
	title: string;
	currentPage?: string;
}

const { title, currentPage } = Astro.props;

const sections = [
	{
		title: "Getting Started",
		items: [
			{ label: "Overview", href: "/docs/feilian-3d" },
			{ label: "Installation", href: "/docs/feilian-3d/installation" },
			{ label: "Quickstart", href: "/docs/feilian-3d/quickstart" },
		]
	},
	{
		title: "Architecture",
		items: [
			{ label: "Architecture", href: "/docs/feilian-3d/architecture" },
			{ label: "Data Pipeline", href: "/docs/feilian-3d/data-pipeline" },
			{ label: "Loss Functions", href: "/docs/feilian-3d/loss-functions" },
		]
	},
	{
		title: "Training",
		items: [
			{ label: "Training", href: "/docs/feilian-3d/training" },
			{ label: "SLURM Config", href: "/docs/feilian-3d/slurm" },
			{ label: "Performance", href: "/docs/feilian-3d/performance" },
		]
	},
	{
		title: "Configuration",
		items: [
			{ label: "Configuration", href: "/docs/feilian-3d/configuration" },
			{ label: "Reproducibility", href: "/docs/feilian-3d/reproducibility" },
		]
	},
	{
		title: "Reference",
		items: [
			{ label: "API Reference", href: "/docs/feilian-3d/api" },
		]
	},
];
---

<PageLayout meta={{ title: `${title} - Feilian-3D Documentation` }}>
	<div class="flex gap-8 max-w-7xl mx-auto px-4 py-8">
		<!-- Floating Navigation Sidebar -->
		<aside class="hidden lg:block lg:w-64 flex-shrink-0">
			<nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto">
				<div class="mb-4 pb-4 border-b border-color-300 dark:border-color-700">
					<a href="/docs" class="text-accent-one hover:text-accent-two transition-colors text-sm">
						← Back to Docs
					</a>
				</div>
				
				<div class="space-y-6">
					{sections.map(section => (
						<div>
							<h3 class="font-semibold text-sm mb-2 text-accent-two">{section.title}</h3>
							<ul class="space-y-1 text-sm">
								{section.items.map(item => (
									<li>
										<a 
											href={item.href}
											class={`block py-1 px-2 rounded transition-colors ${
												currentPage === item.href 
													? 'bg-accent-one/10 text-accent-one font-medium' 
													: 'hover:text-accent-one'
											}`}
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</nav>
		</aside>

		<!-- Main Content -->
		<div class="flex-1 min-w-0">
			<!-- Mobile back button -->
			<div class="mb-6 lg:hidden">
				<a href="/docs" class="text-accent-one hover:text-accent-two transition-colors text-sm">
					← Back to Documentation
				</a>
			</div>

			<article class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-accent-two prose-a:text-accent-one prose-a:no-underline hover:prose-a:text-accent-two hover:prose-a:underline" data-pagefind-body>
				<slot />
			</article>
		</div>
	</div>
</PageLayout>

<style>
	.prose {
		color: var(--color-text);
	}
	
	.prose h1,
	.prose h2,
	.prose h3,
	.prose h4 {
		color: var(--color-accent-two);
		scroll-margin-top: 6rem;
	}
	
	.prose code {
		font-family: var(--font-mono);
		font-size: 0.875em;
	}
	
	.prose pre {
		background-color: var(--color-100);
		border-radius: 0.5rem;
		overflow-x: auto;
	}
	
	.dark .prose pre {
		background-color: var(--color-800);
	}

	.prose table {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
	}

	.prose th {
		background-color: var(--color-100);
		font-weight: 600;
		text-align: left;
		padding: 0.75rem;
		border: 1px solid var(--color-300);
	}

	.dark .prose th {
		background-color: var(--color-800);
		border-color: var(--color-700);
	}

	.prose td {
		padding: 0.75rem;
		border: 1px solid var(--color-300);
	}

	.dark .prose td {
		border-color: var(--color-700);
	}

	/* Scrollbar styling for sidebar */
	nav {
		scrollbar-width: thin;
		scrollbar-color: var(--color-300) transparent;
	}

	nav::-webkit-scrollbar {
		width: 6px;
	}

	nav::-webkit-scrollbar-track {
		background: transparent;
	}

	nav::-webkit-scrollbar-thumb {
		background-color: var(--color-300);
		border-radius: 3px;
	}

	.dark nav::-webkit-scrollbar-thumb {
		background-color: var(--color-700);
	}
</style>
