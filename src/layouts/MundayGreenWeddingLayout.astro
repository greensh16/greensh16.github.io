---
import "@/styles/munday-green-wedding.css";
import { coupleName, weddingLabel } from "@/data/munday-green-wedding";

interface Props {
	title: string;
	description?: string;
}

const { description = weddingLabel, title } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const navItems: { label: string; href: string }[] = [
	{ label: "Schedule", href: "/MundayGreenWedding/schedule/" },
	{ label: "Venue", href: "/MundayGreenWedding/venue/" },
	{ label: "Directions", href: "/MundayGreenWedding/directions/" },
	{ label: "Accommodation", href: "/MundayGreenWedding/accommodation/" },
	{ label: "Registry", href: "/MundayGreenWedding/registry/" },
	{ label: "FAQ", href: "/MundayGreenWedding/faq/" },
];

const pathname = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<html class="mgw" lang="en-US">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" href="/icon.svg" type="image/svg+xml" />

		<!-- Fonts (loaded only for the wedding section) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Indie+Flower&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="mgw-body">
		<!-- Floral decorative background -->
		<div class="mgw-floral-bg">
			<div class="mgw-floral-blobs">
				<div class="mgw-blob mgw-blob--blue"></div>
				<div class="mgw-blob mgw-blob--purple"></div>
				<div class="mgw-blob mgw-blob--yellow"></div>
				<div class="mgw-blob mgw-blob--violet"></div>
				<div class="mgw-blob mgw-blob--blue2"></div>
				<div class="mgw-blob mgw-blob--amber"></div>
			</div>
			<svg class="mgw-floral-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
				<g transform="translate(110 95) rotate(15)"><ellipse cx="0" cy="-38" rx="15" ry="34" fill="#c084fc"/><ellipse cx="0" cy="-38" rx="15" ry="34" fill="#c084fc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-38" rx="15" ry="34" fill="#c084fc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-38" rx="15" ry="34" fill="#c084fc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-38" rx="15" ry="34" fill="#c084fc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="14" fill="#fbbf24"/></g>
				<g transform="translate(710 45) rotate(-10)"><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#7dd3fc"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#7dd3fc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#7dd3fc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#7dd3fc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#7dd3fc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="10" fill="#fde68a"/></g>
				<g transform="translate(1340 110) rotate(5)"><ellipse cx="0" cy="-40" rx="16" ry="36" fill="#fde68a"/><ellipse cx="0" cy="-40" rx="16" ry="36" fill="#fde68a" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-40" rx="16" ry="36" fill="#fde68a" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-40" rx="16" ry="36" fill="#fde68a" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-40" rx="16" ry="36" fill="#fde68a" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="15" fill="#c084fc"/></g>
				<g transform="translate(310 185) rotate(25)"><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#a78bfa"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#a78bfa" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#a78bfa" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#a78bfa" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#a78bfa" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="7" fill="#fde68a"/></g>
				<g transform="translate(1380 230) rotate(-20)"><ellipse cx="0" cy="-28" rx="11" ry="25" fill="#e879f9"/><ellipse cx="0" cy="-28" rx="11" ry="25" fill="#e879f9" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-28" rx="11" ry="25" fill="#e879f9" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-28" rx="11" ry="25" fill="#e879f9" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-28" rx="11" ry="25" fill="#e879f9" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="10" fill="#fbbf24"/></g>
				<g transform="translate(65 490) rotate(30)"><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#38bdf8"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#38bdf8" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#38bdf8" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#38bdf8" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-19" rx="8" ry="17" fill="#38bdf8" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="7" fill="#fde68a"/></g>
				<g transform="translate(420 440) rotate(10)"><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#fbbf24"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#fbbf24" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#fbbf24" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#fbbf24" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#fbbf24" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="5" fill="#c084fc"/></g>
				<g transform="translate(1060 400) rotate(-15)"><ellipse cx="0" cy="-24" rx="10" ry="21" fill="#c084fc"/><ellipse cx="0" cy="-24" rx="10" ry="21" fill="#c084fc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-24" rx="10" ry="21" fill="#c084fc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-24" rx="10" ry="21" fill="#c084fc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-24" rx="10" ry="21" fill="#c084fc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="9" fill="#fde68a"/></g>
				<g transform="translate(1415 520) rotate(35)"><ellipse cx="0" cy="-16" rx="6" ry="14" fill="#7dd3fc"/><ellipse cx="0" cy="-16" rx="6" ry="14" fill="#7dd3fc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-16" rx="6" ry="14" fill="#7dd3fc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-16" rx="6" ry="14" fill="#7dd3fc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-16" rx="6" ry="14" fill="#7dd3fc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="6" fill="#fbbf24"/></g>
				<g transform="translate(185 720) rotate(-5)"><ellipse cx="0" cy="-36" rx="14" ry="32" fill="#a78bfa"/><ellipse cx="0" cy="-36" rx="14" ry="32" fill="#a78bfa" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-36" rx="14" ry="32" fill="#a78bfa" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-36" rx="14" ry="32" fill="#a78bfa" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-36" rx="14" ry="32" fill="#a78bfa" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="13" fill="#fbbf24"/></g>
				<g transform="translate(720 830) rotate(20)"><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#fde68a"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#fde68a" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#fde68a" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#fde68a" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-27" rx="11" ry="24" fill="#fde68a" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="10" fill="#c084fc"/></g>
				<g transform="translate(1280 760) rotate(-25)"><ellipse cx="0" cy="-26" rx="10" ry="23" fill="#93c5fd"/><ellipse cx="0" cy="-26" rx="10" ry="23" fill="#93c5fd" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-26" rx="10" ry="23" fill="#93c5fd" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-26" rx="10" ry="23" fill="#93c5fd" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-26" rx="10" ry="23" fill="#93c5fd" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="9" fill="#fde68a"/></g>
				<g transform="translate(55 875) rotate(15)"><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#c084fc"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#c084fc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#c084fc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#c084fc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#c084fc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="5" fill="#fbbf24"/></g>
				<g transform="translate(1410 870) rotate(-30)"><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#7dd3fc"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#7dd3fc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#7dd3fc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#7dd3fc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-12" rx="5" ry="10" fill="#7dd3fc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="5" fill="#fde68a"/></g>
				<g transform="translate(1115 175) rotate(40)"><ellipse cx="0" cy="-18" rx="7" ry="16" fill="#fde68a"/><ellipse cx="0" cy="-18" rx="7" ry="16" fill="#fde68a" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-18" rx="7" ry="16" fill="#fde68a" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-18" rx="7" ry="16" fill="#fde68a" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-18" rx="7" ry="16" fill="#fde68a" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="7" fill="#a78bfa"/></g>
				<g transform="translate(350 590) rotate(-35)"><ellipse cx="0" cy="-22" rx="9" ry="20" fill="#f0abfc"/><ellipse cx="0" cy="-22" rx="9" ry="20" fill="#f0abfc" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-22" rx="9" ry="20" fill="#f0abfc" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-22" rx="9" ry="20" fill="#f0abfc" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-22" rx="9" ry="20" fill="#f0abfc" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="8" fill="#fbbf24"/></g>
				<g transform="translate(1160 640) rotate(8)"><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#93c5fd"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#93c5fd" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#93c5fd" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#93c5fd" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-13" rx="5" ry="11" fill="#93c5fd" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="5" fill="#fde68a"/></g>
				<g transform="translate(880 310) rotate(-12)"><ellipse cx="0" cy="-23" rx="9" ry="21" fill="#fbbf24"/><ellipse cx="0" cy="-23" rx="9" ry="21" fill="#fbbf24" transform="rotate(72 0 0)"/><ellipse cx="0" cy="-23" rx="9" ry="21" fill="#fbbf24" transform="rotate(144 0 0)"/><ellipse cx="0" cy="-23" rx="9" ry="21" fill="#fbbf24" transform="rotate(216 0 0)"/><ellipse cx="0" cy="-23" rx="9" ry="21" fill="#fbbf24" transform="rotate(288 0 0)"/><circle cx="0" cy="0" r="8" fill="#c084fc"/></g>
			</svg>
		</div>
		<div class="mgw-shell">
			<aside class="mgw-sidebar">
				<nav class="mgw-sidebar-box" aria-label="Wedding contents">
					<p class="mgw-sidebar-eyebrow">Wedding</p>
					<a class="mgw-sidebar-title" href="/MundayGreenWedding/">{coupleName}</a>
					<div class="mgw-nav">
						{navItems.map((item) => {
							const isActive = pathname === item.href;
							return (
								<a
									class={`mgw-nav-link${isActive ? " mgw-nav-link--active" : ""}`}
									href={item.href}
									aria-current={isActive ? "page" : undefined}
								>
									{item.label}
								</a>
							);
						})}
					</div>
				</nav>
			</aside>

			<main class="mgw-main">
				<slot />
			</main>
		</div>

		<footer class="mgw-footer">
			<p class="mgw-footnote">© {new Date().getFullYear()} {coupleName}</p>
		</footer>
	</body>
</html>
